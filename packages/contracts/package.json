{
  "name": "@polechamp/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Schematy zod, OpenAPI 3.1, kody błędów, zdarzenia WS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./openapi.json": "./dist/openapi.json",
    "./api-types": {
      "types": "./dist/api-types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node dist/openapi/build.js && pnpm gen:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "openapi": "node dist/openapi/build.js",
    "history:save": "node scripts/save-history.mjs",
    "gen:client": "openapi-typescript dist/openapi.json -o dist/api-types.d.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.6.7"
  },
  "sideEffects": false,
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
