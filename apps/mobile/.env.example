# Zmienne aplikacji mobilnej (Expo wstawia EXPO_PUBLIC_* przy bundlowaniu). Skopiuj do .env.local.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=http://localhost:3000
# development | preview | production (DevCatalog tylko w development i preview)
EXPO_PUBLIC_APP_VARIANT=development
# Sentry (region UE) – do uzupełnienia po założeniu organizacji i projektu
EXPO_PUBLIC_SENTRY_DSN=
# Linki do sklepów – do uzupełnienia po kontach Apple/Google
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# Build (EAS / app.config.ts) – wartości zastępcze
EAS_PROJECT_ID=
APPLE_TEAM_ID=
