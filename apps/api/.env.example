# Wartości testowe dla środowiska lokalnego (docker-compose.yml). Skopiuj do .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Aplikacja łączy się rolą pc_app; migracje – superużytkownikiem lokalnym (MIGRATION_DATABASE_URL).
DATABASE_URL=postgres://pc_app:pc_app_dev@localhost:5432/polechamp
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/polechamp
PC_APP_PASSWORD=pc_app_dev
VALKEY_URL=redis://localhost:6379

# Klucze generuje: pnpm --filter @polechamp/api dev-keys (zapisuje .secrets/ i wypisuje wartości).
JWT_KEYS=
PIN_FINGERPRINT_KEY=

APP_MIN_VERSION=1.0.0
APP_MIN_SYNC_VERSION=1.0.0
TERMS_VERSION=2026-11
HIBP_ENABLED=false
# Publikator outboxu zdarzeń realtime (Socket.IO /rt); lider wybierany blokadą advisory w PostgreSQL.
EVENT_PUBLISHER_ENABLED=true

# Worker: e-maile do Mailpit (UI: http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=PoleChamp <no-reply@polechamp.app>

# Eksporty PDF (IMP-171): lokalnie S3Mock z docker compose; w chmurze bez endpointu i kluczy (rola IAM) + S3_KMS_KEY_ID.
S3_BUCKET=exports
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
