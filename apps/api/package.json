{
  "name": "@polechamp/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend PoleChamp (NestJS 12 + Fastify) – szkielet",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@polechamp/scoring": "workspace:*",
    "@polechamp/contracts": "workspace:*"
  }
}
