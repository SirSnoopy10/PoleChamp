{
  "name": "@polechamp/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend PoleChamp (NestJS 12 + Fastify) – szkielet",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@polechamp/contracts": "workspace:*",
    "@polechamp/i18n": "workspace:*",
    "@polechamp/scoring": "workspace:*",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "iovalkey": "^0.4.0",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "unplugin-swc": "^2.0.0"
  }
}
