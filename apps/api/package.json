{
  "name": "@polechamp/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend PoleChamp (NestJS 12 + Fastify 5, PostgreSQL 18)",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --env-file-if-exists=.env dist/main.js",
    "migrate": "node --env-file-if-exists=.env dist/cli.js migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "dev-keys": "node dist/dev-keys.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/websockets": "12.2.0",
    "@polechamp/contracts": "workspace:*",
    "@polechamp/i18n": "workspace:*",
    "@polechamp/scoring": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "0.45.1",
    "bullmq": "^6.4.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "^6.0.0",
    "iovalkey": "^0.4.0",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "^4.8.4",
    "testcontainers": "12.2.1",
    "unplugin-swc": "^2.0.0"
  }
}
