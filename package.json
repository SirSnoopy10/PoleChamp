    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "globals": "^17.13.0",
    "lefthook": "2.2.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
